#!/bin/sh
# Power By Qs315490

system_cfg="system.@system[0]"
config_dir="/etc/config"

# --- 1. 时区设置 ---
uci batch<<EOF
	set ${system_cfg}.zonename='Asia/Shanghai'
	set ${system_cfg}.timezone='CST-8'
	commit system
EOF

# --- 2. 设置软件源为清华大学 ---
sed -i 's_downloads.openwrt.org_mirrors.tuna.tsinghua.edu.cn/openwrt_' /etc/opkg/distfeeds.conf

# --- 3. TTYD 配置 (检查初始化脚本更准确) ---
if [ -e /etc/init.d/ttyd ];then
	uci batch<<EOF
	set ttyd.@ttyd[0].command='/bin/login -f root'
	del ttyd.@ttyd[0].interface
	commit ttyd
EOF
fi

# 删除构建时添加的 feeds 源（运行时不需要）
sed -i '/nas\|nas_luci\|istore/d' /etc/opkg/distfeeds.conf

if [ -e /etc/hotplug.d/button/buttons ];then
	chmod +x /etc/hotplug.d/button/buttons
fi

# Config Restart Button
# uci add system button
# uci set system.@button[-1].button="reset"
# uci set system.@button[-1].action="released"
# uci set system.@button[-1].handler="firstboot && reboot"
# uci set system.@button[-1].min="5"
# uci set system.@button[-1].max="30"
# uci commit system


# 退出前，让系统在所有 uci-defaults 配置完成后自动完成重启/重载配置。
exit 0

